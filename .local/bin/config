#!/bin/sh
# The HOME worktree is explicit even when called from another repository.
if [ "${1-}" = shell ]; then
    shift
    script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
    exec "$script_dir/shell-tools" configure "$@"
fi
exec git -C "$HOME" --git-dir="$HOME/.cfg" --work-tree="$HOME" "$@"
