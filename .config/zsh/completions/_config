#compdef config
# _git dispatches by service; leaving it as config calls _config recursively.
# Keep the delegation local so ordinary Git completion retains its own context.
local service=git
if (( CURRENT == 2 )); then
    local -a workflows=('shell:Create or revise shell helpers and public config with Pi')
    _describe 'configuration workflow' workflows
elif [[ ${words[2]-} == shell ]]; then
    if (( CURRENT == 3 )); then
        local -a workflows
        workflows=('add:Create a reusable helper with Pi'
                   'edit:Edit a reusable helper with Pi'
                   'completion:Create or update a Zsh completion handler with Pi'
                   'change:Change public shell configuration with Pi'
                   'finish:Validate and commit a prepared session')
        _describe 'configuration workflow' workflows
    elif [[ ${words[3]-} == completion ]] && (( CURRENT == 4 )); then
        _command_names
    else
        _files
    fi
    return
fi

# Match config's HOME worktree even when completing inside another repository.
local -x GIT_DIR="$HOME/.cfg" GIT_WORK_TREE="$HOME"
local OLDPWD="$OLDPWD"
local -a dirstack=("${dirstack[@]}")
local -i git_completion_status=1
builtin pushd -q -- "$HOME" >/dev/null || return 1
{
    _git "$@"
    git_completion_status=$?
} always {
    builtin popd -q >/dev/null || return 1
}
return $git_completion_status
